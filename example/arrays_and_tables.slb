record Point:
    x: f64
    y: f64
    active: bool

fn main():
    println("=== Slab Arrays (SoA) and Tables (AoS) ===")

    workspace ws:
        # SoA Array (SIMD vectorized column arrays)
        pts = array<Point>[16]
        pts.push(10.0, 20.0, true)
        pts.push(30.0, 40.0, false)
        pts.push(5.0, 15.0, true)

        println("Initial points count:")
        state pts.len

        # Sorting points by x descending
        sort pts by x desc
        println("After sorting by x desc:")
        state pts.x[0], pts.x[1], pts.x[2]

        # Reverse in-place with zero extra RAM
        arc(pts)
        println("After arc(pts) in-place reverse:")
        state pts.x[0], pts.x[1], pts.x[2]

        # AoS Table (contiguous memory, C cache-friendly)
        tbl = table<Point>[16]
        tbl.push(1.0, 2.0, true)
        tbl.push(3.0, 4.0, false)
        println("Table length:")
        state tbl.len
