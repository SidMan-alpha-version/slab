record Particle:
    x: f64
    y: f64
    vx: f64
    vy: f64

fn main():
    println("=== Multi-Core Particle Simulation ===")

    workspace sim_ws:
        n = 10000
        pts = array<Particle>[n]

        # Initialize particles
        for i in 0..n:
            pts.push(i * 0.01, i * 0.02, 1.0, 2.0)

        dt = 0.016
        steps = 5

        println("Running parallel integration across CPU cores...")
        for s in 0..steps:
            parallel for i in 0..n:
                pts.x[i] = pts.x[i] + pts.vx[i] * dt
                pts.y[i] = pts.y[i] + pts.vy[i] * dt

        println("Simulation completed:")
        state pts.x[0], pts.y[0], pts.x[9999], pts.y[9999]
